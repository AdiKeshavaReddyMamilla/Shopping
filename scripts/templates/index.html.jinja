<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Deals & Coupons Hub</title>
<style>
  :root{
    --bg:#0f1220; --panel:#181c2e; --panel-2:#1f2438; --line:#2b3150;
    --text:#e9ecf6; --muted:#9aa3c0; --accent:#6c8cff; --accent-2:#42d6a4;
    --chip:#232842; --danger:#ff6b6b; --radius:16px;
  }
  @media (prefers-color-scheme: light){
    :root{
      --bg:#f4f6fb; --panel:#ffffff; --panel-2:#f0f3fa; --line:#e2e7f2;
      --text:#1a1f36; --muted:#5b6480; --accent:#3b5bff; --accent-2:#0aa678;
      --chip:#eef1fb;
    }
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{
    background:var(--bg); color:var(--text);
    font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased; padding-bottom:40px;
  }
  a{color:inherit}
  .wrap{max-width:920px; margin:0 auto; padding:16px}
  header{
    position:sticky; top:0; z-index:5; backdrop-filter:blur(10px);
    background:color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom:1px solid var(--line);
  }
  .head-inner{max-width:920px; margin:0 auto; padding:14px 16px}
  h1{margin:0; font-size:22px; letter-spacing:.2px}
  h1 .spark{color:var(--accent-2)}
  .updated{color:var(--muted); font-size:12.5px; margin-top:2px}
  .tabs{display:flex; gap:8px; margin-top:12px}
  .tab{
    flex:1; text-align:center; padding:10px 12px; border-radius:12px;
    background:var(--panel); border:1px solid var(--line); color:var(--muted);
    cursor:pointer; font-weight:600; user-select:none;
  }
  .tab.active{color:var(--text); border-color:var(--accent); background:var(--panel-2)}
  .tab .count{font-size:12px; color:var(--muted); font-weight:500}
  .controls{display:flex; flex-wrap:wrap; gap:8px; margin:16px 0 4px}
  .search{
    flex:1 1 220px; min-width:0; padding:11px 14px; border-radius:12px;
    background:var(--panel); border:1px solid var(--line); color:var(--text);
    font-size:15px; outline:none;
  }
  .search:focus{border-color:var(--accent)}
  .chips{display:flex; flex-wrap:wrap; gap:8px; margin:10px 0 18px}
  .chip{
    padding:7px 13px; border-radius:999px; background:var(--chip);
    border:1px solid var(--line); color:var(--muted); font-size:13.5px;
    cursor:pointer; user-select:none; text-transform:capitalize;
  }
  .chip.active{color:#fff; background:var(--accent); border-color:var(--accent)}
  .grid{display:grid; gap:12px}
  .card{
    background:var(--panel); border:1px solid var(--line);
    border-radius:var(--radius); padding:15px 16px; text-decoration:none;
    display:block; transition:transform .06s ease, border-color .12s ease;
  }
  .card:active{transform:scale(.99)}
  .card:hover{border-color:var(--accent)}
  .card .title{font-weight:600; font-size:15.5px; margin:0 0 8px}
  .meta{display:flex; flex-wrap:wrap; gap:8px; align-items:center}
  .badge{
    font-size:12px; font-weight:700; padding:3px 9px; border-radius:999px;
    background:color-mix(in srgb, var(--accent-2) 20%, transparent);
    color:var(--accent-2);
  }
  .badge.price{background:color-mix(in srgb, var(--accent) 18%, transparent); color:var(--accent)}
  .src{font-size:12.5px; color:var(--muted)}
  .cats{display:flex; gap:6px; flex-wrap:wrap; margin-top:9px}
  .cat{font-size:11.5px; color:var(--muted); background:var(--panel-2);
       border:1px solid var(--line); padding:2px 8px; border-radius:999px; text-transform:capitalize}
  /* coupons */
  .coupon{
    background:var(--panel); border:1px solid var(--line);
    border-radius:var(--radius); padding:15px 16px;
    display:flex; gap:12px; align-items:center; justify-content:space-between;
  }
  .coupon .info{min-width:0}
  .coupon .store{font-weight:700; font-size:15.5px}
  .coupon .desc{color:var(--muted); font-size:13.5px; margin-top:3px}
  .coupon .exp{color:var(--muted); font-size:12px; margin-top:5px}
  .code-btn{
    flex:0 0 auto; display:flex; flex-direction:column; align-items:stretch; gap:6px;
    text-align:center;
  }
  .code{
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-weight:700;
    letter-spacing:.5px; padding:9px 14px; border-radius:10px;
    background:var(--panel-2); border:1px dashed var(--accent); color:var(--text);
    cursor:pointer; font-size:14px; white-space:nowrap;
  }
  .code.copied{border-style:solid; background:var(--accent); color:#fff}
  .visit{font-size:12px; color:var(--accent); text-decoration:none}
  .empty{color:var(--muted); text-align:center; padding:48px 12px}
  .hidden{display:none !important}
  footer{color:var(--muted); font-size:12px; text-align:center; margin-top:28px; line-height:1.7}
</style>
</head>
<body>
<header>
  <div class="head-inner">
    <h1>🛍️ My Deals <span class="spark">&amp;</span> Coupons</h1>
    <div class="updated">Updated {{ updated }} · refreshes automatically</div>
    <div class="tabs">
      <div class="tab active" data-tab="deals">Best Deals <span class="count">({{ deals|length }})</span></div>
      <div class="tab" data-tab="coupons">Coupons <span class="count">({{ coupons|length }})</span></div>
    </div>
  </div>
</header>

<div class="wrap">
  <div class="controls">
    <input id="search" class="search" type="search" placeholder="Search deals & coupons…" autocomplete="off">
  </div>
  <div id="chips" class="chips"></div>

  <section id="view-deals">
    <div id="deals" class="grid"></div>
    <div id="deals-empty" class="empty hidden">No deals match. Try a different search or category.</div>
  </section>

  <section id="view-coupons" class="hidden">
    <div id="coupons" class="grid"></div>
    <div id="coupons-empty" class="empty hidden">No coupons match your search.</div>
  </section>

  <footer>
    Deals aggregated from free public feeds (Slickdeals, Reddit, DealNews) and filtered to your watchlist.<br>
    Coupons are your own curated list. Edit <code>watchlist.yaml</code> / <code>coupons.yaml</code> to change what appears here.
  </footer>
</div>

<script id="data" type="application/json">{{ data_json | safe }}</script>
<script>
(function(){
  var DATA = JSON.parse(document.getElementById("data").textContent);
  var state = { tab:"deals", q:"", cat:"all" };

  var el = function(id){ return document.getElementById(id); };
  var esc = function(s){ var d=document.createElement("div"); d.textContent=s==null?"":String(s); return d.innerHTML; };

  function fmtPrice(p){ return "$" + Number(p).toFixed(2).replace(/\.00$/,""); }

  function renderChips(){
    var chips = ["all"].concat(DATA.categories || []);
    el("chips").innerHTML = chips.map(function(c){
      var active = c === state.cat ? " active" : "";
      var label = c === "all" ? "All" : c.replace(/_/g," ");
      return '<span class="chip'+active+'" data-cat="'+esc(c)+'">'+esc(label)+'</span>';
    }).join("");
  }

  function matchQ(text){
    if(!state.q) return true;
    return String(text).toLowerCase().indexOf(state.q) !== -1;
  }

  function renderDeals(){
    var list = (DATA.deals || []).filter(function(d){
      var inCat = state.cat === "all" || (d.categories||[]).indexOf(state.cat) !== -1;
      return inCat && matchQ((d.title||"") + " " + (d.summary||"") + " " + (d.source||""));
    });
    el("deals").innerHTML = list.map(function(d){
      var badges = "";
      if(d.discount) badges += '<span class="badge">'+d.discount+'% off</span>';
      if(d.price!=null) badges += '<span class="badge price">'+fmtPrice(d.price)+'</span>';
      var cats = (d.categories||[]).map(function(c){
        return '<span class="cat">'+esc(c.replace(/_/g," "))+'</span>'; }).join("");
      return '<a class="card" href="'+esc(d.url)+'" target="_blank" rel="noopener">'
        + '<div class="title">'+esc(d.title)+'</div>'
        + '<div class="meta">'+badges+'<span class="src">'+esc(d.source)+'</span></div>'
        + (cats ? '<div class="cats">'+cats+'</div>' : '')
        + '</a>';
    }).join("");
    el("deals-empty").classList.toggle("hidden", list.length>0);
  }

  function renderCoupons(){
    var list = (DATA.coupons || []).filter(function(c){
      var inCat = state.cat === "all" || c.category === state.cat;
      return inCat && matchQ((c.store||"")+" "+(c.description||"")+" "+(c.code||""));
    });
    el("coupons").innerHTML = list.map(function(c, i){
      var exp = c.expires ? '<div class="exp">Expires '+esc(c.expires)+'</div>' : '';
      var visit = c.url ? '<a class="visit" href="'+esc(c.url)+'" target="_blank" rel="noopener">Visit store ↗</a>' : '';
      var code = (c.code && c.code !== "AUTO")
        ? '<button class="code" data-code="'+esc(c.code)+'">'+esc(c.code)+'</button>'
        : '<span class="code" style="cursor:default;border-style:solid">Auto-applied</span>';
      return '<div class="coupon">'
        + '<div class="info"><div class="store">'+esc(c.store)+'</div>'
        + '<div class="desc">'+esc(c.description)+'</div>'+exp+'</div>'
        + '<div class="code-btn">'+code+visit+'</div>'
        + '</div>';
    }).join("");
    el("coupons-empty").classList.toggle("hidden", list.length>0);
  }

  function render(){
    renderChips();
    el("view-deals").classList.toggle("hidden", state.tab!=="deals");
    el("view-coupons").classList.toggle("hidden", state.tab!=="coupons");
    if(state.tab==="deals") renderDeals(); else renderCoupons();
  }

  // events
  document.querySelectorAll(".tab").forEach(function(t){
    t.addEventListener("click", function(){
      document.querySelectorAll(".tab").forEach(function(x){x.classList.remove("active");});
      t.classList.add("active");
      state.tab = t.getAttribute("data-tab");
      state.cat = "all";
      render();
    });
  });
  el("chips").addEventListener("click", function(e){
    var chip = e.target.closest(".chip"); if(!chip) return;
    state.cat = chip.getAttribute("data-cat");
    render();
  });
  el("search").addEventListener("input", function(e){
    state.q = e.target.value.trim().toLowerCase();
    if(state.tab==="deals") renderDeals(); else renderCoupons();
  });
  document.addEventListener("click", function(e){
    var btn = e.target.closest(".code[data-code]"); if(!btn) return;
    var code = btn.getAttribute("data-code");
    var done = function(){ btn.classList.add("copied"); var o=btn.textContent;
      btn.textContent="Copied!"; setTimeout(function(){btn.textContent=o;btn.classList.remove("copied");},1200); };
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(code).then(done, done);
    } else { done(); }
  });

  render();
})();
</script>
</body>
</html>
